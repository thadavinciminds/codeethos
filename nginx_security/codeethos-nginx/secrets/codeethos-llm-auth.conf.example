# /etc/nginx/secrets/codeethos-llm-auth.conf
# The llama.cpp key lives ONLY here on the server — it never reaches browsers.
# Create it with:
#   install -d -m 700 /etc/nginx/secrets
#   KEY='paste-LLAMACPP_API_KEY-here'
#   printf 'proxy_set_header Authorization "Bearer %s";\n' "$KEY" > /etc/nginx/secrets/codeethos-llm-auth.conf
#   chmod 600 /etc/nginx/secrets/codeethos-llm-auth.conf
#
# Resulting file is a single line:
proxy_set_header Authorization "Bearer REPLACE_WITH_LLAMACPP_API_KEY";
